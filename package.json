{
  "name": "lv-zion-worship-duty-app",
  "private": true,
  "scripts": {
    "start": "node scripts/serve.mjs --fake",
    "serve": "node scripts/serve.mjs",
    "build": "node scripts/build.mjs",
    "check": "node --experimental-vm-modules scripts/check-modules.mjs",
    "test": "node --test \"tests/unit/*.test.mjs\" \"tests/rules/*.test.mjs\"",
    "test:rules": "npx -y firebase-tools@15 emulators:exec --only firestore --project demo-wds \"node --test --test-concurrency=1 'tests/rules-emulator/*.test.mjs'\"",
    "test:browser": "node --test \"tests/browser/*.test.mjs\"",
    "test:functions": "npm --prefix functions test",
    "screenshots": "node tests/browser/shoot.mjs"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase": "^12.19.0",
    "playwright": "^1.61.1"
  }
}
