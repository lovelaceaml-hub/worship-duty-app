{
  "hosting": {
    "site": "lv-zion-duties",
    "public": "dist",
    "predeploy": "node scripts/build.mjs",
    "headers": [
      { "source": "/", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "**/*.@(html|js|css|json)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "@(manifest.json|icon.svg)", "headers": [{ "key": "Cache-Control", "value": "max-age=86400" }] }
    ],
    "rewrites": [
      { "source": "/ics/**", "function": "ics" }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "functions": {
    "source": "functions"
  }
}
