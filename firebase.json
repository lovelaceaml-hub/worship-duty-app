{
  "hosting": {
    "site": "lv-zion-duties",
    "public": ".",
    "ignore": ["firebase.json", "**/.*", "**/.*/**", "README.md", "docs/**", "functions/**"],
    "headers": [
      { "source": "/", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "**/index.html", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "**/*.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "**/*.css", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "manifest.json", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "icon.svg", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
    ],
    "rewrites": [
      { "source": "/ics/**", "function": "ics" }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "functions": {
    "source": "functions"
  }
}
