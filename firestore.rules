rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Worship-duty app collections: reads stay open (schedule/roster are shared
    // and the .ics feed reads them), but writes now require an authenticated
    // session. The app signs in anonymously on load (invisible to members), so
    // this blocks anonymous internet scripts from wiping/tampering the data
    // without adding any login. DEPLOY ORDER: enable Anonymous auth + ship the
    // signing-in client BEFORE deploying these rules, or writes will fail.
    match /schedule/{doc} { allow read: if true; allow write: if request.auth != null; }
    // Worship app owns app/* (settings, members, departments, nameMap); the song
    // app only *reads* app/nameMap, so gating writes here does not affect it.
    match /app/{doc}      { allow read: if true; allow write: if request.auth != null; }
    match /tokens/{token} { allow read: if true; allow write: if request.auth != null; }
    match /requests/{doc} { allow read: if true; allow write: if request.auth != null; }
    // New Song Selection app (new-song-app repo, hosted at lv-zion-songs) owns
    // these — left open until that app also ships anonymous auth, otherwise
    // gating them here would break it (shared Firebase project / rules file).
    match /songStats/{doc} { allow read, write: if true; }
    match /setlists/{doc} { allow read, write: if true; }
    // 'sent' markers are functions-only (Admin SDK bypasses these rules):
    match /sent/{doc} { allow read, write: if false; }
  }
}
