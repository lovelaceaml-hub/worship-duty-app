rules_version = '2';

// What the app may read and write directly from a browser. Cloud Functions
// use the Admin SDK and skip these rules, so every change that needs checks
// (assignments, availability, rosters, answers to change requests, roles,
// renames, the Sheet) goes through a callable and is closed here.
//
// A member signs in with a custom token from verifyMemberPin. Its claims say
// who the member is (memberId, memberName). What the member may do comes from
// their account document, accounts/<memberId>, the same document the
// callables read (functions/index.js readCurrentAccount and
// currentTokenForAccount), so the rules and the callables give the same
// answer. tests/rules-emulator runs every operation below on the emulator.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- who is asking ----

    function accountPath() {
      return /databases/$(database)/documents/accounts/$(request.auth.token.memberId);
    }

    function account() {
      return get(accountPath()).data;
    }

    // A member session that still matches its account: a PIN that needs no
    // change, the account in use, its roles unchanged since sign-in
    // (roleVersion; an account without one is at 1, as sign-in counts it),
    // and the session issued for this account. A Firebase user without
    // member claims (another app in this project) is not one.
    function member() {
      return request.auth != null
        && request.auth.token.get('mustChangePin', true) == false
        && request.auth.token.get('memberName', '') is string
        && request.auth.token.get('memberName', '') != ''
        && request.auth.token.get('memberId', '') is string
        && request.auth.token.get('memberId', '') != ''
        && exists(accountPath())
        && sessionMatches(account());
    }

    function sessionMatches(acct) {
      return acct.get('active', true) != false
        && acct.get('mustChangePin', false) != true
        && acct.get('roleVersion', 1) is int
        && acct.get('roleVersion', 1) == request.auth.token.get('roleVersion', null)
        && request.auth.uid == (acct.get('authUid', '') is string && acct.get('authUid', '') != ''
          ? acct.get('authUid', '')
          : 'member:' + request.auth.token.memberId);
    }

    // Roles as the callables read them: the roles list, or else the single
    // role, plus the older true/false fields.
    function rolesOf(acct) {
      return acct.get('roles', []) is list && acct.get('roles', []).size() > 0
        ? acct.get('roles', [])
        : [acct.get('role', 'member')];
    }

    function adminAccount(acct) {
      return acct.get('admin', false) == true
        || rolesOf(acct).hasAny(['admin', 'administrator']);
    }

    function leaderAccount(acct) {
      return acct.get('departmentLeader', false) == true
        || rolesOf(acct).hasAny(['departmentLeader', 'leader']);
    }

    // Whether this account leads a department: an administrator leads them
    // all, a leader the departments listed on the account.
    function ledBy(acct, department) {
      return adminAccount(acct)
        || (leaderAccount(acct) && acct.get('departments', []).hasAny([department]));
    }

    function songEditorAccount(acct) {
      return adminAccount(acct)
        || acct.get('songEditor', false) == true
        || rolesOf(acct).hasAny(['songEditor']);
    }

    function isAdmin() {
      return member() && adminAccount(account());
    }

    function leads(department) {
      return member() && ledBy(account(), department);
    }

    function myName() {
      return request.auth.token.memberName;
    }

    // Whether a name stored in the schedule is the signed-in member. Stored
    // names are the current spelling (the Sheet import maps older ones
    // through app/nameMap); an older spelling that app/nameMap maps to the
    // member counts too, as it does in the app (app/lib/names.js).
    function isMe(name) {
      return name == myName()
        || (exists(/databases/$(database)/documents/app/nameMap)
          && get(/databases/$(database)/documents/app/nameMap).data.get('map', {}).get(name, '') == myName());
    }

    function changes() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // Each department's duties, as DEPARTMENT_DUTIES in permissions.js (a
    // unit test keeps them the same). A chain rather than a map, so a call
    // builds only the list it returns.
    function departmentDuties(department) {
      return department == 'Worship' ? ['Presider', 'Sermon', 'Prayer of Thanks', 'Closing Prayer']
        : department == 'Usher Sisters' ? ['Usher Door', 'Usher Front', 'Usher Back']
        : department == 'Usher Brothers' ? ['Usher #1', 'Usher #2', 'Lobby Security']
        : department == 'Lobby' ? ['Lobby Desk #1', 'Lobby Desk #2']
        : department == 'Translation' ? ['Translation #1', 'Translation #2']
        : department == 'Media' ? ['Media Booth #1', 'Media Booth #2']
        : department == 'Parking Lot' ? ['Parking #1', 'Parking #2', 'Parking #3', 'Parking #4', 'Parking #5']
        : department == 'Offering' ? ['Offering #1', 'Offering #2', 'Offering #3', 'Offering #4', 'Offering #5', 'Offering #6']
        : department == "Children's Teachers" ? ['Small Sanctuary #1', 'Small Sanctuary #2', 'Main Sanctuary #1', 'Main Sanctuary #2']
        : [];
    }

    // ---- the schedule ----

    // The people whose double-duty marks this leader may change: everyone
    // holding a duty of a department they lead in this service ('' for an
    // empty duty). Spelled out per department because a rule cannot loop and
    // stops after 1,000 expressions; a unit test keeps these duties the same
    // as DEPARTMENT_DUTIES in permissions.js.
    function markable(acct, a) {
      let led = leaderAccount(acct) ? acct.get('departments', []) : [];
      return (led.hasAny(['Worship'])
          ? [a.get('Presider', ''), a.get('Sermon', ''), a.get('Prayer of Thanks', ''), a.get('Closing Prayer', '')] : [])
        .concat(led.hasAny(['Usher Sisters'])
          ? [a.get('Usher Door', ''), a.get('Usher Front', ''), a.get('Usher Back', '')] : [])
        .concat(led.hasAny(['Usher Brothers'])
          ? [a.get('Usher #1', ''), a.get('Usher #2', ''), a.get('Lobby Security', '')] : [])
        .concat(led.hasAny(['Lobby'])
          ? [a.get('Lobby Desk #1', ''), a.get('Lobby Desk #2', '')] : [])
        .concat(led.hasAny(['Translation'])
          ? [a.get('Translation #1', ''), a.get('Translation #2', '')] : [])
        .concat(led.hasAny(['Media'])
          ? [a.get('Media Booth #1', ''), a.get('Media Booth #2', '')] : [])
        .concat(led.hasAny(['Parking Lot'])
          ? [a.get('Parking #1', ''), a.get('Parking #2', ''), a.get('Parking #3', ''), a.get('Parking #4', ''),
            a.get('Parking #5', '')] : [])
        .concat(led.hasAny(['Offering'])
          ? [a.get('Offering #1', ''), a.get('Offering #2', ''), a.get('Offering #3', ''), a.get('Offering #4', ''),
            a.get('Offering #5', ''), a.get('Offering #6', '')] : [])
        .concat(led.hasAny(["Children's Teachers"])
          ? [a.get('Small Sanctuary #1', ''), a.get('Small Sanctuary #2', ''), a.get('Main Sanctuary #1', ''),
            a.get('Main Sanctuary #2', '')] : []);
    }

    // Mark a double duty OK, or show its warning again. The app writes the
    // whole conflictOk map with one person's entry set to their duties or
    // removed (app/services/schedule.js markDoubleDuty). A leader may change
    // the entries of people who hold one of their departments' duties in
    // this service, also when other duties are empty; an administrator,
    // anyone's.
    function marksDoubleDuty() {
      return changes().hasOnly(['conflictOk'])
        && request.resource.data.get('conflictOk', null) is map
        && marksOnly(request.resource.data.conflictOk.diff(
          resource.data.get('conflictOk', {}) is map ? resource.data.get('conflictOk', {}) : {}).affectedKeys());
    }

    function marksOnly(changed) {
      return changed.size() > 0
        && member()
        && (adminAccount(account())
          || changed.hasOnly(markable(account(), resource.data.get('assignments', {}))));
    }

    // The choir song: the presider of that service, a song editor or an
    // administrator.
    function setsChoirSong() {
      return changes().hasOnly(['choirSong'])
        && request.resource.data.choirSong is string
        && request.resource.data.choirSong.size() <= 300
        && member()
        && (songEditorAccount(account())
          || isMe(resource.data.get('assignments', {}).get('Presider', '')));
    }

    // An administrator's direct edits in Manage: the time, the worship name
    // or the label of a service. A new date is a new id, so it moves the
    // service instead.
    function editsService() {
      return changes().hasOnly(['time', 'service', 'worship'])
        && isAdmin();
    }

    // Public on purpose: the schedule shows before sign-in and offline, and
    // the calendar feed and publicSchedule serve it too. Administrators add
    // a service (addService, with the Opening Prayer default filled in) and
    // move one (the whole record under its new id, then the old one
    // deleted). Assignments, needsReplacement and assignmentRevisions
    // change only through the callables.
    match /schedule/{serviceId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if setsChoirSong() || marksDoubleDuty() || editsService();
    }

    // ---- app documents ----

    function secretFieldsAbsent(data) {
      return !data.keys().hasAny([
        'pin', 'pinHash', 'sitePinHash', 'editorPinHash', 'passwordHash', 'credentialHash',
        'passcode', 'passcodeHash', 'pinCode', 'password', 'hash'
      ]);
    }

    // Read before sign-in: settings (the lock screen's passcode check),
    // members (the name picker), departments, leaderConfig and nameMap
    // (names on the schedule). A document not written yet reads as missing,
    // so its listener keeps running. Only app/settings is written from the
    // app; the server writes the rest.
    match /app/{document} {
      allow get: if document in ['settings', 'members', 'departments', 'leaderConfig', 'nameMap']
        && (resource == null || document == 'settings' || secretFieldsAbsent(resource.data));
      allow create, update: if document == 'settings' && isAdmin();
    }

    // ---- change requests ----

    // A member asks for a change to a duty they hold in that service, in
    // their own name. The server tells that department's leaders.
    function asksForOwnDuty(requestId) {
      let data = request.resource.data;
      let servicePath = /databases/$(database)/documents/schedule/$(data.svcId);
      return data.keys().hasOnly(['id', 'name', 'memberId', 'requesterUid', 'svcId', 'date', 'service',
          'worship', 'duty', 'department', 'note', 'status', 'createdAt'])
        && data.id == requestId
        && data.requesterUid == request.auth.uid
        && data.status == 'pending'
        && data.note is string
        && data.note.size() <= 500
        && data.worship is string
        && data.worship.size() <= 100
        && data.createdAt is number
        && data.duty is string
        && data.duty != ''
        && departmentDuties(data.department).hasAny([data.duty])
        && member()
        && data.name == myName()
        && data.memberId == request.auth.token.memberId
        && data.svcId is string
        && exists(servicePath)
        && get(servicePath).data.get('date', '') == data.date
        && get(servicePath).data.get('service', '') == data['service']
        && isMe(get(servicePath).data.get('assignments', {}).get(data.duty, ''));
    }

    // The member who sent a pending request may withdraw it.
    function withdrawsOwnRequest() {
      return resource.data.requesterUid == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.status == 'withdrawn'
        && changes().hasOnly(['status', 'updatedAt'])
        && request.resource.data.get('updatedAt', 0) is number
        && member();
    }

    // Members read their own requests (the listener filters on requesterUid);
    // leaders read their departments' (it filters department in [...]);
    // administrators read all. Answers go through resolveDutyAttention.
    match /requests/{requestId} {
      allow read: if (resource.data.requesterUid == request.auth.uid && member())
        || leads(resource.data.department);
      allow create: if asksForOwnDuty(requestId);
      allow update: if withdrawsOwnRequest();
    }

    // ---- what a member reads or writes about themselves ----

    // A member's own profile in each department (their availability), and
    // the profiles of a department's members for its leaders. The callables
    // write them and list rosters (listDepartmentRoster).
    match /departments/{department}/members/{memberUid} {
      allow get: if (request.auth != null && request.auth.uid == memberUid && member())
        || leads(department);
    }

    // This phone's push token, named for the member signed in on it. The
    // next member who signs in on a shared phone takes it over (the token id
    // is known only to that phone). The member it names may delete it, also
    // after their session has gone stale, for example when signing out.
    match /tokens/{token} {
      allow create, update: if request.resource.data.keys().hasOnly(['name', 'updatedAt', 'lastSeenAt'])
        && request.resource.data.get('updatedAt', 0) is number
        && request.resource.data.get('lastSeenAt', 0) is number
        && member()
        && request.resource.data.get('name', '') == myName();
      allow delete: if request.auth != null
        && request.auth.token.get('memberName', '') is string
        && request.auth.token.get('memberName', '') != ''
        && (resource == null || resource.data.get('name', '') == request.auth.token.get('memberName', ''));
    }

    // Feedback notes: any member sends one under their own uid; the name on
    // it is the one the app shows (app/services/feedback.js sends the short
    // display form), and the "marked done" alert goes to the member the uid
    // belongs to. Administrators read them, mark them done and delete them.
    match /feedback/{feedbackId} {
      allow create: if request.resource.data.keys().hasOnly(['uid', 'name', 'kind', 'message', 'screen', 'appearance', 'createdAt', 'status'])
        && request.resource.data.kind in ['feedback', 'bug', 'suggestion']
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 2000
        && request.resource.data.get('screen', '') is string
        && request.resource.data.get('screen', '').size() <= 40
        && request.resource.data.get('appearance', '') is string
        && request.resource.data.get('appearance', '').size() <= 40
        && request.resource.data.get('createdAt', 0) is number
        && request.resource.data.status == 'new'
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 80
        && request.resource.data.uid == request.auth.uid
        && member();
      allow read, delete: if isAdmin();
      allow update: if changes().hasOnly(['status'])
        && request.resource.data.status in ['new', 'done']
        && isAdmin();
    }

    // The daily usage count: each write adds one to one counter of that
    // day's document (app/services/usage.js). Nothing in it names a person.
    function countsOne(day) {
      let before = resource == null ? {} : resource.data;
      let after = request.resource.data;
      let changed = after.diff(before).affectedKeys();
      return changed.hasOnly(['date', 'opens', 'tab_schedule', 'tab_my', 'tab_songs', 'tab_manage'])
        && after.get('date', '') == day
        && (!('opens' in changed) || after.opens == before.get('opens', 0) + 1)
        && (!('tab_schedule' in changed) || after.tab_schedule == before.get('tab_schedule', 0) + 1)
        && (!('tab_my' in changed) || after.tab_my == before.get('tab_my', 0) + 1)
        && (!('tab_songs' in changed) || after.tab_songs == before.get('tab_songs', 0) + 1)
        && (!('tab_manage' in changed) || after.tab_manage == before.get('tab_manage', 0) + 1);
    }

    match /pulse/{day} {
      allow read: if isAdmin();
      allow create, update: if countsOne(day) && member();
    }

    // ---- songs ----

    // Signed-in members only: song planners read and write these from the
    // song planner. The Signal song ingest does not sign in; it reads and
    // writes them through the songIngest function, with its own token.
    match /songStats/{songId} {
      allow read, write: if member();
    }

    match /setlists/{setlistId} {
      allow read, write: if member();
    }

    // Everything else is server-only or unused: accounts (PIN hashes and
    // roles), audit (also PIN resets), departmentAssignments,
    // departmentInvitations, sent, sheetQueue, sheetImport, deletedServices, the other
    // app documents, and the retired departmentSchedules, memberships,
    // conflicts, notifications and alerts.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
